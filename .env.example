# ==========================================
# FILE MẪU BIẾN MÔI TRƯỜNG (.env.example)
# ==========================================
# Khi clone code về máy mới, hãy copy file này, 
# đổi tên thành ".env" và điền các giá trị thực tế vào bên dưới.

# 1. Cấu hình Database & Server
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/youtube_clone
JWT_SECRET=nhap_chuoi_ky_tu_bi_mat_cho_jwt_vao_day
CLIENT_URL=http://localhost:3000

# 2. Cấu hình Đăng nhập bằng Google (OAuth2)
# Lấy tại: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=nhap_google_client_id_vao_day
GOOGLE_CLIENT_SECRET=nhap_google_client_secret_vao_day

# 3. Cấu hình lưu trữ Video/Ảnh (Cloudinary)
# Lấy tại: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=nhap_cloud_name_vao_day
CLOUDINARY_API_KEY=nhap_api_key_vao_day
CLOUDINARY_API_SECRET=nhap_api_secret_vao_day

# 4. Cấu hình Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api
